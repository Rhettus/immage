+// inspect JPEG headers by seeking over segments, without reading compressed pixels
+static bool _jpeg_dimensions(Exiv2::BasicIo &io, const size_t offset, const size_t length,
+                             unsigned int &width, unsigned int &height)
+{
+  unsigned char bytes[7];
+  if(length < 4 || io.seek(offset, Exiv2::BasicIo::beg) || io.read(bytes, 2) != 2
+     || bytes[0] != 0xff || bytes[1] != 0xd8)
+    return false;
+  size_t at = 2;
+  for(int markers = 0; markers < 1024 && at + 4 <= length; markers++)
+  {
+    if(io.seek(offset + at, Exiv2::BasicIo::beg) || io.read(bytes, 4) != 4 || bytes[0] != 0xff)
+      return false;
+    const unsigned int marker = bytes[1];
+    if(marker == 0xff) { at++; continue; }
+    if(marker == 0xda || marker == 0xd9) return false;
+    const size_t segment = ((size_t)bytes[2] << 8) | bytes[3];
+    if(segment < 2 || segment > length - at - 2) return false;
+    if(marker >= 0xc0 && marker <= 0xcf && marker != 0xc4 && marker != 0xc8 && marker != 0xcc)
+    {
+      if(segment < 8 || io.read(bytes, 5) != 5) return false;
+      height = ((unsigned int)bytes[1] << 8) | bytes[2];
+      width = ((unsigned int)bytes[3] << 8) | bytes[4];
+      return width > 0 && height > 0;
+    }
+    at += 2 + segment;
+  }
+  return false;
+}
+
+static bool _read_jpeg_thumbnail(Exiv2::Image &image, const int target,
+                                 uint8_t **buffer, size_t *size, char **mime_type)
+{
+  auto &io = image.io();
+  if(io.open()) return false;
+  Exiv2::IoCloser closer(io);
+  const size_t length = io.size();
+  std::vector<std::pair<size_t, size_t>> ranges;
+  const auto add_range = [&](const uint64_t offset, const uint64_t bytes)
+  {
+    if(bytes > 0 && offset <= length && bytes <= length - offset)
+      ranges.emplace_back(offset, bytes);
+  };
+  const auto &exif = image.exifData();
+  const auto number = [&](const std::string &key) -> int64_t
+  {
+    const auto pos = exif.findKey(Exiv2::ExifKey(key));
+    return pos != exif.end() && pos->count() == 1 ? pos->toLong() : -1;
+  };
+  // these TIFF groups use absolute offsets; maker-note offsets can have
+  // vendor-specific bases and stay with the general Exiv2 fallback
+  const char *groups[] = { "Image", "Image2", "Image3", "Thumbnail", "SubThumb1",
+                           "SubImage1", "SubImage2", "SubImage3", "SubImage4" };
+  for(const auto group : groups)
+  {
+    const std::string prefix = std::string("Exif.") + group + ".";
+    add_range(number(prefix + "JPEGInterchangeFormat"), number(prefix + "JPEGInterchangeFormatLength"));
+    const auto compression = number(prefix + "Compression");
+    const auto photometric = number(prefix + "PhotometricInterpretation");
+    if((compression == 6 || compression == 7)
+       && (photometric == 2 || photometric == 6
+           || (!strcmp(group, "Image") && image.mimeType() == "image/x-canon-cr2")))
+      add_range(number(prefix + "StripOffsets"), number(prefix + "StripByteCounts"));
+  }
+  for(const auto &preview : image.nativePreviews())
+    if(preview.mimeType_ == "image/jpeg" && preview.filter_.empty())
+      add_range(preview.position_, preview.size_);
+
+  size_t best_offset = 0, best_length = 0;
+  uint64_t best_pixels = UINT64_MAX;
+  for(const auto &range : ranges)
+  {
+    unsigned int width = 0, height = 0;
+    if(_jpeg_dimensions(io, range.first, range.second, width, height)
+       && std::max(width, height) >= (unsigned int)target)
+    {
+      const uint64_t pixels = (uint64_t)width * height;
+      if(pixels < best_pixels)
+      {
+        best_offset = range.first;
+        best_length = range.second;
+        best_pixels = pixels;
+      }
+    }
+  }
+  std::vector<uint8_t> embedded;
+  const char *data_keys[] = { "Exif.Thumbnail.JPEGInterchangeFormat",
+                              "Exif.NikonPreview.JPEGInterchangeFormat",
+                              "Exif.Pentax.PreviewOffset", "Exif.PentaxDng.PreviewOffset",
+                              "Exif.SamsungPreview.JPEGInterchangeFormat" };
+  for(const auto key : data_keys)
+  {
+    const auto pos = exif.findKey(Exiv2::ExifKey(key));
+    if(pos == exif.end() || !pos->sizeDataArea()) continue;
+    const auto data = pos->dataArea();
+#if EXIV2_TEST_VERSION(0,28,0)
+    const auto data_bytes = data.c_data();
+    const size_t data_size = data.size();
+#else
+    const auto data_bytes = data.pData_;
+    const size_t data_size = data.size_;
+#endif
+    Exiv2::MemIo jpeg(data_bytes, data_size);
+    unsigned int width = 0, height = 0;
+    if(_jpeg_dimensions(jpeg, 0, data_size, width, height)
+       && std::max(width, height) >= (unsigned int)target && (uint64_t)width * height < best_pixels)
+    {
+      best_pixels = (uint64_t)width * height;
+      best_length = data_size;
+      embedded.assign(data_bytes, data_bytes + data_size);
+    }
+  }
+  if(!best_length) return false;
+  auto bytes = std::unique_ptr<uint8_t, decltype(&free)>((uint8_t *)malloc(best_length), free);
+  if(!bytes) return false;
+  if(!embedded.empty())
+    memcpy(bytes.get(), embedded.data(), best_length);
+  else if(io.seek(best_offset, Exiv2::BasicIo::beg) || (size_t)io.read(bytes.get(), best_length) != best_length)
+    return false;
+  *mime_type = strdup("image/jpeg");
+  if(!*mime_type) return false;
+  *size = best_length;
+  *buffer = bytes.release();
+  return true;
+}
