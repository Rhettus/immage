+// a source file read whole, for exiv2 to parse from memory. exiv2 maps
+// TIFF-based files, and a mapped file whose network share drops (the
+// computer sleeping) raises SIGBUS, where read() only returns an error
+class FileData
+{
+public:
+  gchar *data = NULL;
+  gsize size = 0;
+  ~FileData() { g_free(data); }
+};
+
+// the image must not outlive file, which holds its bytes
+static std::unique_ptr<Exiv2::Image> _open_read(const char *path, FileData &file)
+{
+  if(!g_file_get_contents(path, &file.data, &file.size, NULL))
+    // let exiv2 report the error as it does for any file it cannot open
+    return std::unique_ptr<Exiv2::Image>(Exiv2::ImageFactory::open(WIDEN(path)));
+  return std::unique_ptr<Exiv2::Image>(
+    Exiv2::ImageFactory::open((const Exiv2::byte *)file.data, file.size));
+}
