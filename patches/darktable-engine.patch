+// a source file read whole, for exiv2 to parse from memory. exiv2 maps
+// TIFF-based files, and a mapped file whose network share drops (the
+// computer sleeping) raises SIGBUS, where read() only returns an error
+class FileData
+{
+public:
+  gchar *data = NULL;
+  gsize size = 0;
+  ~FileData() { g_free(data); }
+};
+
+// the image must not outlive file, which holds its bytes
+static std::unique_ptr<Exiv2::Image> _open_read(const char *path, FileData &file)
+{
+  g_clear_pointer(&file.data, g_free);
+  GError *error = NULL;
+  if(!g_file_get_contents(path, &file.data, &file.size, &error))
+  {
+    const std::string message = error ? error->message : "could not read metadata source";
+    g_clear_error(&error);
+    throw Exiv2::Error(Exiv2::ErrorCode::kerErrorMessage, message);
+  }
+  return std::unique_ptr<Exiv2::Image>(
+    Exiv2::ImageFactory::open((const Exiv2::byte *)file.data, file.size));
+}
+
+// Exiv2 accepts incomplete TIFF directories with a warning instead of failing
+// only missing pixel strips are harmless when reading metadata
+static thread_local bool _reading_prefix = false;
+static thread_local bool _prefix_incomplete = false;
+
+class ReadFileIo : public Exiv2::FileIo
+{
+public:
+  explicit ReadFileIo(const char *path) : Exiv2::FileIo(WIDEN(path)) {}
+  Exiv2::byte *mmap(bool writeable = false) override
+  {
+    if(writeable)
+      throw Exiv2::Error(Exiv2::ErrorCode::kerErrorMessage, "read-only metadata source");
+    const size_t length = size();
+    if(length == SIZE_MAX || length < _data.size())
+      throw Exiv2::Error(Exiv2::ErrorCode::kerInputDataReadFailed);
+    if(_data.size() != length)
+    {
+      const size_t used = _data.size();
+      _data.resize(length);
+      if(seek(used, Exiv2::BasicIo::beg) || (size_t)read(_data.data() + used, length - used) != length - used)
+      {
+        _data.clear();
+        throw Exiv2::Error(Exiv2::ErrorCode::kerInputDataReadFailed);
+      }
+    }
+    return _data.data();
+  }
+  int munmap() override { return 0; }
+  void cache_prefix(const gchar *data, const size_t size)
+  {
+    if(size) _data.assign(data, data + size);
+  }
+private:
+  std::vector<Exiv2::byte> _data;
+};
+
+static std::unique_ptr<Exiv2::Image> _read_metadata(const char *path, FileData &file)
+{
+  // FileIo reads JPEG segments and CR3 boxes by seeking; only TIFF-like
+  // formats need a contiguous buffer, supplied by ReadFileIo without mmap
+#if EXIV2_TEST_VERSION(0,28,0)
+  auto io = std::make_unique<ReadFileIo>(path);
+#else
+  Exiv2::BasicIo::AutoPtr io(new ReadFileIo(path));
+#endif
+  if(io->open())
+    throw Exiv2::Error(Exiv2::ErrorCode::kerDataSourceOpenFailed, path, g_strerror(errno));
+  const size_t length = io->size();
+  unsigned char header[4] = {};
+  const bool tiff = (size_t)io->read(header, sizeof(header)) == sizeof(header)
+                    && (!memcmp(header, "II*\0", 4) || !memcmp(header, "MM\0*", 4));
+  if(tiff && Exiv2::LogMsg::level() <= Exiv2::LogMsg::warn)
+  {
+    size_t used = 0;
+    for(size_t limit = 64 * 1024; limit < length && limit <= 16 * 1024 * 1024; limit *= 4)
+    {
+      file.data = (gchar *)g_realloc(file.data, limit);
+      if(io->seek(used, Exiv2::BasicIo::beg)
+         || (size_t)io->read((Exiv2::byte *)file.data + used, limit - used) != limit - used)
+        throw Exiv2::Error(Exiv2::ErrorCode::kerInputDataReadFailed);
+      used = file.size = limit;
+      std::unique_ptr<Exiv2::Image> image;
+      bool complete = false;
+      {
+        Lock lock;
+        _reading_prefix = true;
+        _prefix_incomplete = false;
+        try
+        {
+          image = Exiv2::ImageFactory::open((const Exiv2::byte *)file.data, file.size);
+          if(image) image->readMetadata();
+          complete = image && !_prefix_incomplete;
+        }
+        catch(const Exiv2::AnyError &) {}
+        catch(...) { _reading_prefix = false; throw; }
+        _reading_prefix = false;
+      }
+      if(complete)
+      {
+        // preview JPEGs may be outside the metadata prefix: keep the file's
+        // real extent and let the thumbnail reader seek to their bytes
+        std::unique_ptr<Exiv2::Image> source(Exiv2::ImageFactory::open(std::move(io)));
+        source->setExifData(image->exifData());
+        source->setIptcData(image->iptcData());
+        source->setXmpData(image->xmpData());
+        source->setByteOrder(image->byteOrder());
+        return source;
+      }
+    }
+  }
+  static_cast<ReadFileIo *>(io.get())->cache_prefix(file.data, file.size);
+  g_clear_pointer(&file.data, g_free);
+  file.size = 0;
+  std::unique_ptr<Exiv2::Image> image(Exiv2::ImageFactory::open(std::move(io)));
+  if(image)
+  {
+    read_metadata_threadsafe(image);
+  }
+  return image;
+}
