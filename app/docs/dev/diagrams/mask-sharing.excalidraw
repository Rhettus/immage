  {
   "id": "t55",
   "type": "text",
   "x": 40,
   "y": 626,
   "width": 1612.8,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 22608065,
   "version": 1,
   "versionNonce": 86717586,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each member counts at its strength over the shared one (20 / 40 = 0.5), times its Opacity. darktable blends out = in + mask \u00b7 (module(in) - in), so Trees gets about Saturation +20.",
   "originalText": "Each member counts at its strength over the shared one (20 / 40 = 0.5), times its Opacity. darktable blends out = in + mask \u00b7 (module(in) - in), so Trees gets about Saturation +20.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t56",
   "type": "text",
   "x": 40,
   "y": 652,
   "width": 1702.4,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1094180540,
   "version": 1,
   "versionNonce": 1388924530,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Masks are grouped by the direction of their sliders, or by slider and sign: Face, pointing the other way, gets an instance of its own. Ten masks raising Saturation still run the module once.",
   "originalText": "Masks are grouped by the direction of their sliders, or by slider and sign: Face, pointing the other way, gets an instance of its own. Ten masks raising Saturation still run the module once.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t57",
   "type": "text",
   "x": 40,
   "y": 678,
   "width": 1801.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2103154095,
   "version": 1,
   "versionNonce": 2021412009,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where members overlap the sum adds up, as in Lightroom; the shared strength is set for where it adds up most, as the combined mask stops at 1. Here they do not overlap, so it is the strongest member's.",
   "originalText": "Where members overlap the sum adds up, as in Lightroom; the shared strength is set for where it adds up most, as the combined mask stops at 1. Here they do not overlap, so it is the strongest member's.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t58",
   "type": "text",
   "x": 40,
   "y": 704,
   "width": 1406.7,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 24041929,
   "version": 1,
   "versionNonce": 191255431,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Dragging Trees lifts it out of combined mask 1 onto its own instance, which runs after the shared ones: the drag reruns only that. It joins again on release.",
   "originalText": "Dragging Trees lifts it out of combined mask 1 onto its own instance, which runs after the shared ones: the drag reruns only that. It joins again on release.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
