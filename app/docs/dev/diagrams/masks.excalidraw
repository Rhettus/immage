   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "masks with the same slider\nshare one instance\n(\"immage local: ...\") on a\ncombined mask (\"immage\ncombined: ...\"), so ten masks\nare not ten copies",
   "originalText": "masks with the same slider\nshare one instance\n(\"immage local: ...\") on a\ncombined mask (\"immage\ncombined: ...\"), so ten masks\nare not ten copies",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n1",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t97",
   "type": "text",
   "x": 40,
   "y": 1508,
   "width": 1809.9,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1696999184,
   "version": 1,
   "versionNonce": 106806813,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A mask's instances run right after color balance rgb, in linear scene-referred data, before the tone mapper: a local +1 EV is exposure's +1 EV under the mask, and AgX maps it with the rest of the photo.",
   "originalText": "A mask's instances run right after color balance rgb, in linear scene-referred data, before the tone mapper: a local +1 EV is exposure's +1 EV under the mask, and AgX maps it with the rest of the photo.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t98",
   "type": "text",
   "x": 40,
   "y": 1534,
   "width": 1594.9,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2028708488,
   "version": 1,
   "versionNonce": 1251825968,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The order is fixed: Immage places every instance and the user cannot move modules. darktable opens the same XMP and shows each instance as an ordinary module with its drawn mask.",
   "originalText": "The order is fixed: Immage places every instance and the user cannot move modules. darktable opens the same XMP and shows each instance as an ordinary module with its drawn mask.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
