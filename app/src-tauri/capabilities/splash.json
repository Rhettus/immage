{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "splash",
  "description": "the startup splash: dragging it, then showing the main window and closing itself",
  "windows": [
    "splash"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
