{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the main window: core APIs, dragging the window by its title strip, the folder picker, and the importer",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "immporter:default"
  ]
}
